{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:admin": "VITE_APP_TARGET=admin vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:customer": "VITE_APP_TARGET=customer vite build",
    "build:technician": "VITE_APP_TARGET=technician vite build",
    "customer:web": "VITE_APP_TARGET=customer vite build",
    "customer:android": "npx tsx scripts/prepare_mobile.ts --target=customer --platform=android",
    "customer:android:bundle": "npm run customer:android && echo 'Command for AAB: cd android && ./gradlew :app:bundleRelease'",
    "customer:android:assemble": "npm run customer:android && echo 'Command for APK: cd android && ./gradlew :app:assembleRelease'",
    "customer:ios": "npx tsx scripts/prepare_mobile.ts --target=customer --platform=ios",
    "customer:sync": "npx tsx scripts/prepare_mobile.ts --target=customer --platform=all",
    "technician:web": "VITE_APP_TARGET=technician vite build",
    "technician:android": "npx tsx scripts/prepare_mobile.ts --target=technician --platform=android",
    "technician:android:bundle": "npm run technician:android && echo 'Command for AAB: cd android && ./gradlew :app:bundleRelease'",
    "technician:android:assemble": "npm run technician:android && echo 'Command for APK: cd android && ./gradlew :app:assembleRelease'",
    "technician:ios": "npx tsx scripts/prepare_mobile.ts --target=technician --platform=ios",
    "technician:sync": "npx tsx scripts/prepare_mobile.ts --target=technician --platform=all",
    "admin:web": "VITE_APP_TARGET=admin vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "test:step9": "tsx scripts/verify_step9_technician_mobile.ts",
    "test:step10": "tsx scripts/verify_step10_production.ts",
    "test:step11": "tsx scripts/verify_step11_release_readiness.ts",
    "test:step12": "tsx scripts/verify_step12_android_playstore.ts",
    "test:step13": "tsx scripts/verify_step13_ios_appstore.ts",
    "test:step14": "tsx scripts/verify_step14_production_environment.ts",
    "test:step15": "tsx scripts/verify_step15_production_release.ts",
    "test:step16": "tsx scripts/verify_step16_play_store_prep.ts",
    "test:step17": "tsx scripts/verify_step17_customer_play_store_prep.ts",
    "test:rbac": "tsx scripts/verify_step_rbac_enhancement.ts",
    "test:step3c": "tsx scripts/verify_step3c_financial_integrity.ts",
    "test:step3d": "tsx scripts/verify_step3d_integration_concurrency.ts",
    "start": "node dist/server.cjs",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/preferences": "^8.0.1",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@electric-sql/pglite": "^0.5.8",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
