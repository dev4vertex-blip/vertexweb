{
	"appId": "com.vertex.technician",
	"appName": "VERTEX Technician",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"cleartext": false
	},
	"android": {
		"allowMixedContent": false,
		"captureInput": true
	},
	"ios": {
		"contentInset": "always",
		"allowsLinkPreview": false,
		"scrollEnabled": true
	},
	"plugins": {
		"Preferences": {
			"group": "VERTEXTechnicianApp"
		},
		"App": {}
	},
	"packageClassList": [
		"AppPlugin",
		"PreferencesPlugin"
	]
}
