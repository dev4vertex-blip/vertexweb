# =============================================================================
# VERTEX ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =============================================================================
# Copy this file to .env for local development or configure in your deployment platform.
# DO NOT commit real production credentials, keys, or secrets into this file.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SERVER-SIDE CONFIGURATION (Backend Only - NEVER expose to client/mobile)
# -----------------------------------------------------------------------------
# Database connection string (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres

# JWT Secret for signing authenticated user tokens
JWT_SECRET=replace-with-cryptographically-secure-random-secret-in-production

# Gemini AI API Key for server-side smart diagnostics
GEMINI_API_KEY=

# Server Environment & Port
NODE_ENV=development
PORT=3000

# Server-Side Demo Login Control
# In development: 'true' enables demo endpoints, quick login, and testing accounts
# In production: MUST BE 'false' (backend strictly returns 401/403 for demo/bypass)
DEMO_LOGIN_ENABLED=true

# Allowed CORS Origins (Configured in .env for development)
# Mobile Capacitor apps use native scheme protocols (capacitor://, https://localhost)
# ALLOWED_ORIGINS=http://localhost:3000,https://ais-dev-zdmpnbna4272ukxruns2hc-215954351316.asia-east1.run.app,https://ais-pre-zdmpnbna4272ukxruns2hc-215954351316.asia-east1.run.app,https://admin.vertexservices.in,https://app.vertexservices.in

# -----------------------------------------------------------------------------
# 2. CLIENT-SIDE & MOBILE CONFIGURATION (Publicly bundled via Vite VITE_*)
# -----------------------------------------------------------------------------
# Build Target Application:
# - 'customer'   : Bundles only VERTEX Customer mobile/web application
# - 'technician' : Bundles only VERTEX Technician partner mobile/web application
# - 'admin'      : Bundles VERTEX Enterprise Admin Portal (Web only)
# - 'all'        : Unified multi-app development workspace (default for dev preview)
VITE_APP_TARGET=all

# Client Demo Helper & Test Switcher Control
# In development: 'true' renders demo credentials switcher and test OTP prefill
# In production: MUST BE 'false' (hides all demo UI and disables simulation OTP)
VITE_DEMO_LOGIN_ENABLED=true

# Production HTTPS API Base URL
# Must be an encrypted HTTPS domain (e.g., https://api.vertexservices.in)
# NOTICE: Production API URL must be supplied before final release build.
# For local dev / same-origin proxy, defaults to empty string ("").
# VITE_API_BASE_URL=

# =============================================================================
# ENVIRONMENT PROFILES REFERENCE
# =============================================================================

# --- PROFILE A: LOCAL DEVELOPMENT ---
# NODE_ENV=development
# DEMO_LOGIN_ENABLED=true
# VITE_DEMO_LOGIN_ENABLED=true
# VITE_APP_TARGET=all
# VITE_API_BASE_URL=

# --- PROFILE B: STAGING ENVIRONMENT ---
# NODE_ENV=staging
# DEMO_LOGIN_ENABLED=false
# VITE_DEMO_LOGIN_ENABLED=false
# VITE_APP_TARGET=customer   # (or 'technician' or 'admin')
# VITE_API_BASE_URL=https://staging-api.vertexservices.in

# --- PROFILE C: PRODUCTION RELEASE ---
# NODE_ENV=production
# DEMO_LOGIN_ENABLED=false
# VITE_DEMO_LOGIN_ENABLED=false
# VITE_APP_TARGET=customer   # (or 'technician' or 'admin')
# VITE_API_BASE_URL=https://api.vertexservices.in


